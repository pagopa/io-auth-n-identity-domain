HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Login
LOGIN_SUCCESS_REDIRECT_URL=http://localhost:3000/success
LOGIN_ERROR_REDIRECT_URL=http://localhost:3000/error

# JWT session token
JWT_TOKEN_ISSUER=io-web-auth-service
# PEM-encoded EC (RS-256) private key, newlines may be escaped as \n
JWT_TOKEN_PRIVATE_KEY=example
JWT_TOKEN_TTL_SECONDS=3600

# Logger
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_ENTRA_ID_AUTH_ENABLED=false
APPLICATIONINSIGHTS_CONFIGURATION_FILE=./applicationinsights.json
APPINSIGHTS_SAMPLING_PERCENTAGE=100
OTEL_SERVICE_NAME=io-web-auth-service

# OneIdentity
ONEID_PROD_CLIENT_ID=
ONEID_PROD_CLIENT_SECRET=
ONEID_PROD_ISSUER=https://oneid.pagopa.it
ONEID_PROD_REDIRECT_URI=http://localhost:3000/callback

# Leave UAT credentials empty to use PROD only.
ONEID_UAT_CLIENT_ID=
ONEID_UAT_CLIENT_SECRET=
ONEID_UAT_ISSUER=https://uat.oneid.pagopa.it
ONEID_HTTP_TIMEOUT_SECONDS=8

# Redis
REDIS_HOSTNAME=localhost
REDIS_PORT=6379
REDIS_TLS_ENABLED=false
# Leave empty for passwordless local Redis.
REDIS_PASSWORD=
LOGIN_AUXILIARY_DATA_TTL_SECONDS=900
