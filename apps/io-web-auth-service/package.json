{
  "name": "io-web-auth-service",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist/*",
    "applicationinsights.json"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsc",
    "build:watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:check --fix",
    "lint:check": "eslint .",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "test": "vitest run -c ./vite.config.mts",
    "test:coverage": "vitest run --coverage -c ./vite.config.mts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@pagopa/azure-tracing": "catalog:",
    "@pagopa/hexagonal-core": "catalog:",
    "@pagopa/hexagonal-fastify": "catalog:",
    "@pagopa/io-auth-n-identity-domain": "workspace:^",
    "@pagopa/io-env-config": "workspace:^",
    "@pagopa/io-package-info": "workspace:^",
    "dotenv": "catalog:",
    "fastify": "catalog:",
    "neverthrow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pagopa/hexagonal-openapi": "catalog:",
    "@pagopa/typescript-config-node22": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-monorepo": "workspace:^",
    "shx": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
