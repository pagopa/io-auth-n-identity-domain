HOST=0.0.0.0
PORT=8001
NODE_ENV=development

LOLLIPOP_API_KEY=your-lollipop-api-key
LOLLIPOP_API_URL=http://localhost:7071
LOLLIPOP_API_BASE_PATH=/api/v1

IO_PROFILE_API_KEY=your-io-profile-api-key
IO_PROFILE_API_URL=http://localhost:7076
IO_PROFILE_API_BASE_PATH=/api/v1

LOCKED_PROFILES_TABLE_NAME=lockedprofile01
# The following is used only in development environments.
# Default value points to the Azurite emulator started by the repo's
# docker-compose (host port 20005) with the well-known dev account key.
LOCKED_PROFILES_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:20003/devstoreaccount1;QueueEndpoint=http://127.0.0.1:20004/devstoreaccount1;TableEndpoint=http://127.0.0.1:20005/devstoreaccount1;"
# The following is used only in production environments
# LOCKED_PROFILES_STORAGE_ACCOUNT_URI=your-locked-profiles-storage-account-uri

IO_FAST_LOGIN_API_KEY=your-io-fast-login-api-key
IO_FAST_LOGIN_API_URL=http://localhost:7075
IO_FAST_LOGIN_API_BASE_PATH=/api/v1

IO_SM_INT_API_KEY=your-sm-int-api-key
IO_SM_INT_API_URL=http://localhost:7077
IO_SM_INT_API_BASE_PATH=/api/v1

PUSH_NOTIFICATIONS_QUEUE_NAME=push-notifications
# The following is used only in development environments.
# Default value points to the Azurite emulator started by the repo's
# docker-compose (host port 20005) with the well-known dev account key.
PUSH_NOTIFICATIONS_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:20003/devstoreaccount1;QueueEndpoint=http://127.0.0.1:20004/devstoreaccount1;TableEndpoint=http://127.0.0.1:20005/devstoreaccount1;"
# The following is used only in production environments
# PUSH_NOTIFICATIONS_QUEUE_STORAGE_URI=your-notifications-storage-account-uri

REDIS_HOSTNAME=localhost
# Optional port override
REDIS_PORT=6378
REDIS_PASSWORD=bitnami
REDIS_TLS_ENABLED=false

AUTH_SESSIONS_TOPIC_NAME=auth-sessions
SERVICE_BUS_CONNECTION_STRING=your-service-bus-conn-string
# The following is used only in production environments
# SERVICE_BUS_HOSTNAME=your-service-bus-hostname

# Comma-separated list of IPv4 CIDR blocks allowed to reach BPD SSO endpoints.
# Example: "10.0.0.0/8,192.168.1.1/32"
ALLOW_BPD_IP_SOURCE_RANGE=0.0.0.0/0
