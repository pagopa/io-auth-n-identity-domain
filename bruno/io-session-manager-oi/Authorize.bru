meta {
  name: Authorize
  type: http
  seq: 3
}

get {
  url: {{oidc_redirect_url}}
  body: none
  auth: inherit
}

script:pre-request {
  req.setMaxRedirects(0);
  
  req.setHeader("x-pagopa-lollipop-assertion-ref", bru.getEnvVar("assertionRef") || "")
}

script:post-response {
  console.log("OneID authorize location response ---->",res.getHeader("location"))
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
