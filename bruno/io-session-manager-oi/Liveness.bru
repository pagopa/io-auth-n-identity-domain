meta {
  name: Liveness
  type: http
  seq: 1
}

get {
  url: {{IO_SESSION_MANAGER_OI_BASE_URL}}/api/auth/v2/health/liveness
  body: none
  auth: none
}

script:pre-request {
  if (bru.getEnvName() === "Production") {
    req.setUrl(bru.interpolate("{{process.env.IO_SESSION_MANAGER_OI_CONTAINER_APPLICATION_URL}}/api/auth/v2/health/liveness"));
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
