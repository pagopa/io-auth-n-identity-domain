meta {
  name: Callback
  type: http
  seq: 3
}

get {
  url: {{IO_WEB_AUTH_SERVICE_BASE_URL}}/callback?state=&code=
  body: none
  auth: none
}

params:query {
  state: 
  code: 
}

script:pre-request {
  req.setMaxRedirects(0);
}

script:post-response {
  const location=res.headers["location"]
  
  if (!location || location.length == 0){
    throw new Error("Expected a location")
  }
  
  const sessionToken=location.replace(/^.*\#token\=/,"")
  
  if (sessionToken.length == 0){
    throw new Error("Expected a token")
  }
  
  bru.setEnvVar("IO_WEB_AUTH_SERVICE_TOKEN", sessionToken)
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: false
  maxRedirects: 5
  forwardAuthorizationHeader: true
}
