meta {
  name: Healthcheck
  type: http
  seq: 1
}

get {
  url: {{IO_SESSION_MANAGER_BASE_URL}}/api/auth/v1/healthcheck
  body: none
  auth: none
}

script:pre-request {
  req.setMaxRedirects(0);
  
  req.setHeader("x-pagopa-lollipop-assertion-ref", bru.getEnvVar("assertionRef") || "")
}

script:post-response {
  console.log("↓ OneID authorize location response ↓")
  console.log(res.getHeader("location"))
}

settings {
  encodeUrl: false
  timeout: 0
  followRedirects: false
  maxRedirects: 5
  forwardAuthorizationHeader: false
}
