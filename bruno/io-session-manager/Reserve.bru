meta {
  name: Reserve
  type: http
  seq: 3
}

post {
  url: {{IO_SESSION_MANAGER_BASE_URL}}/api/auth/v1/reserve
  body: json
  auth: none
}

body:json {
  {
    "env": "UAT",
    "min_auth_level": "SpidL2",
    "lollipop_pub_key": "SET_IN_PREREQUEST",
    "login_type": "LV"
  }
}

script:pre-request {
  const crypto = require("node:crypto");
  const jose = require("node-jose");
  
  req.setMaxRedirects(0);
  
  const { publicKey, privateKey } = crypto.generateKeyPairSync("ec", {
    namedCurve: "P-256",
    publicKeyEncoding: {
      type: "spki",
      format: "jwk",
    },
    privateKeyEncoding: {
      type: "pkcs8",
      format: "jwk"
    }
  });
  
  const jwk = JSON.stringify(publicKey);
  const encodedPubKey = Buffer.from(jwk).toString("base64url");
  const encodedPrivateKey =  Buffer.from(JSON.stringify(privateKey)).toString("base64url")
  
  const assertionRef = await jose.JWK.asKey(jwk)
    .then(key => key.thumbprint('SHA-256'))
    .then(thumbprint => thumbprint.toString('base64url'));
  
  const body = req.getBody();
  body.lollipop_pub_key = encodedPubKey;
  req.setBody(body);
  
  bru.setEnvVar("publicKey", encodedPubKey)
  bru.setEnvVar("privateKey", encodedPrivateKey)
  bru.setEnvVar("assertionRef", `sha256-${assertionRef}`)
}

script:post-response {
  const { URL } = require("node:url");
  const { state, nonce, client_id, redirect_uri, authorization_endpoint, acr_values } = res.body;
  // TODO: Remove the fallback in the equivalent io-session-manager-oi PR.
  const resolvedAcrValues = acr_values ?? `https://www.spid.gov.it/${req.getBody().min_auth_level}`;
  
  if (![state, nonce, client_id, redirect_uri, authorization_endpoint].every(value => typeof value === "string" && value.length > 0)) {
    throw new Error("Expected the reserve response to include all authorization parameters");
  }
  
  const idp = "https://idp.uat.io.oneid.pagopa.it";
  //const idp = "https://preproduzione.idserver.servizicie.interno.gov.it/idp/profile/SAML2/POST/SSO";
  
  const redirectUrl = new URL(authorization_endpoint);
  const parameters = {
    client_id,
    redirect_uri,
    scope: "openid",
    state,
    nonce,
    response_type: "code",
    acr_values: resolvedAcrValues,
    idp,
  };
  for (const [name, value] of Object.entries(parameters)) {
    redirectUrl.searchParams.set(name, value);
  }
  bru.setEnvVar("oidc_redirect_url", redirectUrl.toString());
}
