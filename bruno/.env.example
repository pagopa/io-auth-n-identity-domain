IO_PROFILE_API_KEY=IO_PROFILE_API_KEY
IO_LOLLIPOP_API_KEY=IO_LOLLIPOP_API_KEY
TEST_USER_USERNAME=username
TEST_USER_PASSWORD=password

# The following is used to set the base URL for the IO Session Manager OI container application while using the Production environment
# for the Liveness and Readiness checks, which are not exposed through the public base URL
IO_SESSION_MANAGER_OI_CONTAINER_APPLICATION_URL=https://<your-container-app-url>
